rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo permitimos crear registros de clicks de contacto desde el cliente;
    // nadie puede leer, editar ni borrar esta colección desde afuera.
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
